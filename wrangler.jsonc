/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "gomon",
	"main": "./build/worker.mjs",
	"compatibility_date": "2025-03-12",
	// Static dashboard assets. Served from the edge without invoking the Go
	// worker; API routes fall through to the worker (run_worker_first=false).
	"assets": {
		"directory": "./public"
	},
	"build": {
		"command": "npm run build"
	},
	"observability": {
		"enabled": true
	},
	"triggers": {
		// Run every 15 minutes. On the Workers Free plan the cron CPU limit is
		// 10ms, and the Go worker needs ~50ms, so most ticks are killed
		// (exceededCpu). A longer cadence means fewer killed invocations/day.
		"crons": ["*/15 * * * *"]
	},
	"vars": {
		"D1_BINDING": "DB",
		"MIN_FREQUENCY": "240", // in seconds; keep below the cron interval so every tick is due
		"MONITOR_TIMEOUT_SEC": "2", // per-check HTTP deadline; enforced via AbortSignal.timeout
		"WEBHOOK_NOTIFY_ON_RECOVERY": "true",
		"WEBHOOK_MAX_ATTEMPTS": "3",
		"WEBHOOK_INITIAL_DELAY_SEC": "30",
		"WEBHOOK_MAX_DELAY_SEC": "300",
		"WEBHOOK_BACKOFF_FACTOR": "2",
		"WEBHOOK_REPEAT_UNHEALTHY_COOLDOWN_SEC": "10"
	},
	"routes": [
		{
		  "pattern": "gomon.rowentey.xyz",
		  "custom_domain": true
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "gomon",
			"database_id": "7b05cf24-7237-4b25-a42f-964b51e19ccd",
			"migrations_dir": "migrations"
		}
	]
}
